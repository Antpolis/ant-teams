{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [],
  "default_agent": "ant",
  "provider": {
    "bw-llm": {
      "options": {
        "baseURL": "http://192.168.50.10:11434/v1"
      },
      "models": {
        "gemma4:31b-it-q8_0": {}
      }
    }
  },
  "permissions": [
    {
