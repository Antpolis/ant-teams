      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/home/chrissim/.config/opencode/skills/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/home/chrissim/.agents/skills/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/home/chrissim/.agents/scripts/*",
      "effect": "allow"
    },
    {
      "action": "external_directory",
      "resource": "/home/chrissim/Projects/documentation/*",
      "effect": "allow"
    }
